# Copy to docker/.env - compose reads it automatically for ${...} in
# docker-compose.yml. Keep it out of git; it holds real passwords.
#
# None of these have defaults on purpose. A missing value stops the
# stack, which is the correct outcome - a default password is a password
# everyone already knows.

# One per agent, matching the roles in postgres/least_privilege_roles.sql.
# Change them there too; the values must agree.
ORCHESTRATOR_PG_PASSWORD=
HR_PG_PASSWORD=
CRM_PG_PASSWORD=

REDIS_PASSWORD=
