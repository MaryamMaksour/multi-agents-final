# ==================== Process role ====================
# One image, one codebase. These two variables decide what a process serves.
#   AGENT_ROLE=orchestrator                -> the main agent
#   AGENT_ROLE=sub_agent AGENT_DOMAIN=hr   -> the HR agent
#   AGENT_ROLE=sub_agent AGENT_DOMAIN=crm  -> the CRM agent
AGENT_ROLE=orchestrator
AGENT_DOMAIN=

APP_NAME=multi-agents
APP_VERSION=2.0.0

# ==================== LLM (OpenAI-compatible) ====================
# The hosted API today and a local vLLM server later speak the same
# protocol, so switching is a change to LLM_API_URL, not to any code:
#   hosted : https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   vLLM   : http://vllm:8000/v1        (and LLM_API_KEY can stay empty)
GENERATION_BACKEND=openai_compat
EMBEDDING_BACKEND=openai_compat

LLM_API_KEY=
LLM_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GENERATION_MODEL_ID=qwen3-14b
GENERATION_DEFAULT_TEMPERATURE=0.1
GENERATION_DEFAULT_MAX_TOKENS=32000

# EMBEDDING_MODEL_SIZE must match the vector(n) width of the history
# tables. Self-hosting later with bge-m3 keeps 1024, so no reindexing.
EMBEDDING_MODEL_ID=text-embedding-v3
EMBEDDING_MODEL_SIZE=1024

# ==================== PostgreSQL / pgvector ====================
# No defaults on purpose: an unset value must fail to connect loudly
# rather than quietly reach some other network's database.
PG_HOST=pgvector
PG_PORT=5432
PG_DBNAME=Evolution
PG_USER=
PG_PASSWORD=
PG_SSL=false

DB_POOL_MIN=1
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=60

# '<->' L2 | '<#>' inner product | '<=>' cosine
DIST_OP=<=>

# ==================== Redis (orchestrator only) ====================
REDIS_URL=redis://:changeme@redis:6379/1
SESSION_TTL_SECONDS=259200
MAX_SESSION_MESSAGES=40

# ==================== Tool limits ====================
# Enforced in code, never left to the prompt to respect.
SQL_DEFAULT_LIMIT=6
SQL_MAX_LIMIT=100
SQL_MAX_OFFSET=5000
SQL_STATEMENT_TIMEOUT_MS=30000
AGENT_MAX_ITERATIONS=12

# ==================== Semantic memory ====================
# Past turns replayed as few-shot examples. Only the reasoning is stored
# and replayed - never the rows a query returned.
MEMORY_ENABLED=true
MEMORY_GOOD_EXAMPLES=3
MEMORY_BAD_EXAMPLES=1
MEMORY_WINDOW_DAYS=3

# ==================== Sub-agent routing (orchestrator only) ====================
# One "domain=url" entry per deployed agent. The orchestrator builds a
# delegation tool per entry, so adding an agent never edits its code.
SUB_AGENT_URLS=["hr=http://agent-hr:8002","crm=http://agent-crm:8003"]
SUB_AGENT_TIMEOUT_SECS=60

# ==================== Authorization ====================
# When true, every statement runs in a transaction that first sets
# app.user_id, so Postgres row-level security policies apply. Turn on
# once authentication is in place and RLS policies exist.
RLS_ENABLED=false
